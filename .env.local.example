# Required for the vision assessment (lib/visionExtract.ts) — runs on every
# request (Government Warning formatting can't be checked from OCR text
# alone), and also fills in field gaps when OCR confidence is low or a
# required field is missing.
ANTHROPIC_API_KEY=

# Optional: point the vision assessment at a self-hosted, Ollama-compatible
# vision model instead of the Anthropic API (e.g. for a network that blocks
# outbound calls to api.anthropic.com). Leave unset to use Anthropic.
# VISION_BACKEND=local
# LOCAL_VISION_URL=http://localhost:11434/api/chat
# LOCAL_VISION_MODEL=llava
